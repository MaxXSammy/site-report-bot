# LLM und Spracherkennung (lokal, kostenlos)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
WHISPER_MODEL=medium

# Telegram (Token von @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat-IDs, die den Bot nutzen dürfen, kommagetrennt. Leer heißt: niemand.
# Unbekannte Chats bekommen ihre ID als Antwort und können sie hier eintragen lassen.
TELEGRAM_ALLOWED_CHAT_IDS=

# Protokollierung (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# WhatsApp Cloud API (optional, erfordert verifiziertes Meta-Business-Konto)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# App-Secret aus dem Meta-Entwicklerportal, damit gefälschte Webhook-Aufrufe abgelehnt werden
WHATSAPP_APP_SECRET=